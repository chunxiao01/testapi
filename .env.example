# ============ 四个协议的端口（可自由修改）============
HTTP_PORT=3000
HTTPS_PORT=3443
WS_PORT=3001
WSS_PORT=3444

# ============ 四个协议的开关（false 表示不启动）============
HTTP_ENABLE=true
HTTPS_ENABLE=true
WS_ENABLE=true
WSS_ENABLE=true

# ============ JWT 配置 ============
JWT_SECRET=please-change-this-secret-in-production
JWT_EXPIRES_IN=2h

# ============ 证书路径（不写默认 certs/server.key、certs/server.crt）============
# SSL_KEY=./certs/server.key
# SSL_CERT=./certs/server.crt